###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 4 – ACCELERATOR CARDS
# ══════════════════════════════════════════════════════════════════════════════
# Cards are the unit of allocation; memory is modeled at card level.
###############################################################################

inst:Card_NvidiaV100_16GB rdf:type hpc:AcceleratorCard ;
    rdfs:label "NVIDIA Tesla V100 SXM2 16 GB card"@en ;
    rdfs:comment "NVIDIA V100 SXM2 card with 16 GB HBM2. Used in Jean Zay gpu_p13_v100_16g nodes (4 per node)."@en ,
                 "Carte NVIDIA V100 SXM2 16 Go HBM2. Utilisée dans les nœuds gpu_p13_v100_16g de Jean Zay (4 par nœud)."@fr ;
    hpc:vendor "NVIDIA" ;
    hpc:model "Tesla V100 SXM2 16 GB" ;
    hpc:acceleratorUnitsPerCard 1 ;
    hpc:hostsAccelerator inst:GPU_NvidiaV100_SXM2_16GB ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_V100_HBM2_16GiB ;
        hpc:quantity 1
    ] .

inst:Card_NvidiaV100_32GB rdf:type hpc:AcceleratorCard ;
    rdfs:label "NVIDIA Tesla V100 SXM2 32 GB card"@en ;
    rdfs:comment "NVIDIA V100 SXM2 card with 32 GB HBM2. Used in Jean Zay gpu_p13 (32 GB variant) and gpu_p2 nodes (4 or 8 per node)."@en ,
                 "Carte NVIDIA V100 SXM2 32 Go HBM2. Utilisée dans les nœuds gpu_p13 (variante 32 Go) et gpu_p2 de Jean Zay (4 ou 8 par nœud)."@fr ;
    hpc:vendor "NVIDIA" ;
    hpc:model "Tesla V100 SXM2 32 GB" ;
    hpc:acceleratorUnitsPerCard 1 ;
    hpc:hostsAccelerator inst:GPU_NvidiaV100_SXM2_32GB ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_V100_HBM2_32GiB ;
        hpc:quantity 1
    ] .

inst:Card_NvidiaA100_80GB rdf:type hpc:AcceleratorCard ;
    rdfs:label "NVIDIA A100 SXM4 80 GB card"@en ;
    rdfs:comment "NVIDIA A100 SXM4 card with 80 GB HBM2e. Used in Jean Zay gpu_p5 nodes (8 per node). TDP 400 W."@en ,
                 "Carte NVIDIA A100 SXM4 80 Go HBM2e. Utilisée dans les nœuds gpu_p5 de Jean Zay (8 par nœud). TDP 400 W."@fr ;
    hpc:vendor "NVIDIA" ;
    hpc:model "A100 SXM4 80 GB" ;
    hpc:acceleratorUnitsPerCard 1 ;
    hpc:hostsAccelerator inst:GPU_NvidiaA100_SXM4_80GB ;
    hpc:hasTDP [ rdf:type hpc:TDP ; hpc:hasValue "400"^^xsd:decimal ; hpc:hasUnit "W" ] ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_A100_HBM2e_80GiB ;
        hpc:quantity 1
    ] .

inst:Card_NvidiaH100_80GB rdf:type hpc:AcceleratorCard ;
    rdfs:label "NVIDIA H100 SXM5 80 GB card"@en ;
    rdfs:comment "NVIDIA H100 SXM5 card with 80 GB HBM3. Used in the Jean Zay gpu_p6 H100 extension (4 per node). TDP 700 W."@en ,
                 "Carte NVIDIA H100 SXM5 80 Go HBM3. Utilisée dans l'extension H100 gpu_p6 de Jean Zay (4 par nœud). TDP 700 W."@fr ;
    hpc:vendor "NVIDIA" ;
    hpc:model "H100 SXM5 80 GB" ;
    hpc:acceleratorUnitsPerCard 1 ;
    hpc:hostsAccelerator inst:GPU_NvidiaH100_SXM5_80GB ;
    hpc:hasTDP [ rdf:type hpc:TDP ; hpc:hasValue "700"^^xsd:decimal ; hpc:hasUnit "W" ] ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_H100_HBM3_80GiB ;
        hpc:quantity 1
    ] .

inst:Card_NvidiaV100_JZ_prepost rdf:type hpc:AcceleratorCard ; 
    rdfs:label "NVIDIA Tesla V100 card (prepost, memory variant not stated)"@en ;
    rdfs:comment "NVIDIA Tesla V100 card of the prepost nodes (1 per node). IDRIS does not state the memory size, so no memory component is declared."@en ,
                 "Carte NVIDIA Tesla V100 des nœuds prepost (1 par nœud). L'IDRIS ne précise pas la mémoire ; aucun composant mémoire n'est déclaré."@fr ;
    hpc:vendor "NVIDIA" ;
    hpc:model "Tesla V100" ;
    hpc:acceleratorUnitsPerCard 1 ;
    hpc:hostsAccelerator inst:GPU_NvidiaV100_SXM2_32GB .     # [TBC] die model reused; variant unknown

inst:Card_NvidiaQuadroP6000 rdf:type hpc:AcceleratorCard ;
    rdfs:label "NVIDIA Quadro P6000 card"@en ;
    rdfs:comment "NVIDIA Quadro P6000 card of the visu nodes (1 per node)."@en ,
                 "Carte NVIDIA Quadro P6000 des nœuds visu (1 par nœud)."@fr ;
    hpc:vendor "NVIDIA" ;
    hpc:model "Quadro P6000" ;
    hpc:acceleratorUnitsPerCard 1 ;
    hpc:hostsAccelerator inst:GPU_NvidiaQuadroP6000 .


###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 5 – COMPUTE NODES (node TYPES)
# ══════════════════════════════════════════════════════════════════════════════
# Representative node TYPES referenced by partitions (not individual nodes).
###############################################################################

# ──── cpu_p1 scalar node ──────────────────────────────────────────────────────
# 720 nodes. 2× Intel Xeon Gold 6248 (20 cores) = 40 cores/node. 192 GiB DDR4.
# 1× Intel Omni-Path 100 Gb/s NIC.
inst:Node_JZ_cpu_p1 rdf:type hpc:ScalarNode ;
    rdfs:label "Jean Zay – cpu_p1 scalar node type"@en ,
               "Jean Zay – type nœud scalaire cpu_p1"@fr ;
    rdfs:comment "720 scalar CPU nodes. 2×Intel Xeon Gold 6248 (40 cores/node), 192 GiB DDR4, 1×Intel Omni-Path 100 Gb/s. Used for pure-MPI and memory-bandwidth-bound jobs."@en ,
                 "720 nœuds CPU scalaires. 2×Intel Xeon Gold 6248 (40 cœurs/nœud), 192 Gio DDR4, 1×Intel Omni-Path 100 Gb/s. Destinés aux calculs MPI et aux charges limitées par la bande passante mémoire."@fr ;
    hpc:coresCountPerNode 40 ;
    hpc:hasCPUComponent [
        rdf:type hpc:CPUComponent ;
        hpc:refersToModel inst:CPU_Intel_XeonGold_6248 ;
        hpc:quantity 2
    ] ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_DDR4_2933_192GiB ;
        hpc:quantity 1
    ] ;
    hpc:hasInterconnectComponent [
        rdf:type hpc:InterconnectComponent ;
        hpc:refersToModel inst:IC_OmniPath_100G ;
        hpc:linkCount 1
    ] ;
    hpc:belongsToPartition inst:Part_JZ_cpu_p1 .

# ──── gpu_p13 V100 node types (16 GB and 32 GB) ───────────────────────────────
inst:Node_JZ_gpu_p13_v100_16g rdf:type hpc:AcceleratedNode ;
    rdfs:label "Jean Zay – gpu_p13 V100 16 GB node type"@en ,
               "Jean Zay – type nœud gpu_p13 V100 16 Go"@fr ;
    rdfs:comment "126 nodes. 2×Intel Xeon Gold 6248 (40 cores), 192 GiB DDR4, 4×NVIDIA V100 SXM2 16 GB. 1×Omni-Path NIC."@en ,
                 "126 nœuds. 2×Intel Xeon Gold 6248 (40 cœurs), 192 Gio DDR4, 4×NVIDIA V100 SXM2 16 Go. 1×NIC Omni-Path."@fr ;
    hpc:coresCountPerNode 40 ;
    hpc:hasCPUComponent [
        rdf:type hpc:CPUComponent ;
        hpc:refersToModel inst:CPU_Intel_XeonGold_6248 ;
        hpc:quantity 2
    ] ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_DDR4_2933_192GiB ;
        hpc:quantity 1
    ] ;
    hpc:hasAcceleratorCardComponent [
        rdf:type hpc:AcceleratorCardComponent ;
        hpc:refersToModel inst:Card_NvidiaV100_16GB ;
        hpc:quantity 4
    ] ;
    hpc:hasInterconnectComponent [
        rdf:type hpc:InterconnectComponent ;
        hpc:refersToModel inst:IC_OmniPath_100G ;
        hpc:linkCount 1
    ] ;
    hpc:belongsToPartition inst:Part_JZ_gpu_p13 .

inst:Node_JZ_gpu_p13_v100_32g rdf:type hpc:AcceleratedNode ;
    rdfs:label "Jean Zay – gpu_p13 V100 32 GB node type"@en ,
               "Jean Zay – type nœud gpu_p13 V100 32 Go"@fr ;
    rdfs:comment "270 nodes. 2×Intel Xeon Gold 6248 (40 cores), 192 GiB DDR4, 4×NVIDIA V100 SXM2 32 GB. 1×Omni-Path NIC."@en ,
                 "270 nœuds. 2×Intel Xeon Gold 6248 (40 cœurs), 192 Gio DDR4, 4×NVIDIA V100 SXM2 32 Go. 1×NIC Omni-Path."@fr ;
    hpc:coresCountPerNode 40 ;
    hpc:hasCPUComponent [
        rdf:type hpc:CPUComponent ;
        hpc:refersToModel inst:CPU_Intel_XeonGold_6248 ;
        hpc:quantity 2
    ] ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_DDR4_2933_192GiB ;
        hpc:quantity 1
    ] ;
    hpc:hasAcceleratorCardComponent [
        rdf:type hpc:AcceleratorCardComponent ;
        hpc:refersToModel inst:Card_NvidiaV100_32GB ;
        hpc:quantity 4
    ] ;
    hpc:hasInterconnectComponent [
        rdf:type hpc:InterconnectComponent ;
        hpc:refersToModel inst:IC_OmniPath_100G ;
        hpc:linkCount 1
    ] ;
    hpc:belongsToPartition inst:Part_JZ_gpu_p13 .

# ──── gpu_p2 node types (larger memory / 8 GPUs) ─────────────────────────────
inst:Node_JZ_gpu_p2s rdf:type hpc:AcceleratedNode ;
    rdfs:label "Jean Zay – gpu_p2s node type"@en ,
               "Jean Zay – type nœud gpu_p2s"@fr ;
    rdfs:comment "20 nodes. 2×Intel Xeon Gold 6226 (24 cores), 384 GiB DDR4, 8×NVIDIA V100 SXM2 32 GB. 2×Omni-Path NIC."@en ,
                 "20 nœuds. 2×Intel Xeon Gold 6226 (24 cœurs), 384 Gio DDR4, 8×NVIDIA V100 SXM2 32 Go. 2×NIC Omni-Path."@fr ;
    hpc:coresCountPerNode 24 ;
    hpc:hasCPUComponent [
