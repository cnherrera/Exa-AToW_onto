    hpc:hasCPUComponent [
        rdf:type hpc:CPUComponent ;
        hpc:refersToModel inst:CPU_Intel_Skylake_6132 ;
        hpc:quantity 4
    ] ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_DDR4_3TiB ;
        hpc:quantity 1
    ] ;
    hpc:hasAcceleratorCardComponent [
        rdf:type hpc:AcceleratorCardComponent ;
        hpc:refersToModel inst:Card_NvidiaV100_JZ_prepost ;
        hpc:quantity 1
    ] ;
    hpc:belongsToPartition inst:Part_JZ_prepost .

inst:Node_JZ_visu rdf:type hpc:VisualizationNode ;
    rdfs:label "Jean Zay – visualization node type"@en ,
               "Jean Zay – type nœud visualisation"@fr ;
    rdfs:comment "5 scalar visualization nodes: 2×Intel Cascade Lake 6248 (40 cores/node), 192 GiB, 1×NVIDIA Quadro P6000. Not deducted from the compute allocation."@en ,
                 "5 nœuds de visualisation de type scalaire : 2×Intel Cascade Lake 6248 (40 cœurs/nœud), 192 Gio, 1×NVIDIA Quadro P6000. Non décomptés de l'allocation."@fr ;
    hpc:coresCountPerNode 40 ;
    hpc:hasCPUComponent [
        rdf:type hpc:CPUComponent ;
        hpc:refersToModel inst:CPU_Intel_XeonGold_6248 ;
        hpc:quantity 2
    ] ;
    hpc:hasMemoryComponent [
        rdf:type hpc:MemoryComponent ;
        hpc:refersToModel inst:Mem_DDR4_2933_192GiB ;
        hpc:quantity 1
    ] ;
    hpc:hasAcceleratorCardComponent [
        rdf:type hpc:AcceleratorCardComponent ;
        hpc:refersToModel inst:Card_NvidiaQuadroP6000 ;
        hpc:quantity 1
    ] ;
    hpc:belongsToPartition inst:Part_JZ_visu .

inst:Node_JZ_frontend rdf:type hpc:FrontendNode ; 
    rdfs:label "Jean Zay – frontend/login node type"@en ,
               "Jean Zay – type nœud frontal"@fr ;
    rdfs:comment "5 frontend nodes reached by SSH: 2×Intel Cascade Lake 6248 (40 cores/node), 192 GiB."@en ,
                 "5 nœuds frontaux (connexion SSH) : 2×Intel Cascade Lake 6248 (40 cœurs/nœud), 192 Gio."@fr ;
