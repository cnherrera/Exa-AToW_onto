    hpc:maxGpusPerProject 32 ;
    hpc:maxJobsPerUser 10 .


###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 9 – FILE SYSTEM & STORAGE MOUNTS
# ══════════════════════════════════════════════════════════════════════════════
# EN – Jean Zay's shared storage is a Lustre file system. The legacy
#      :JeanZayScratch record in hpc.ttl is contradictory (GPFS capacity +
#      Lustre technology); here we provide a clean Lustre file system and the
#      four user workspaces ($HOME, $WORK, $SCRATCH, $STORE).
# FR – Le stockage partagé de Jean Zay est un système Lustre. L'enregistrement
#      historique :JeanZayScratch dans hpc.ttl est contradictoire ; on fournit
#      ici un système Lustre propre et les quatre espaces utilisateur.
# Verified 2026-10-28 against the IDRIS 'Espaces disques' page. Quotas are DEFAULTS
# (per user for HOME, per project for WORK/STORE) and can be raised on request.
###############################################################################

### check, isParallelis a property of FileSystemTechno?
inst:FS_JeanZay_Lustre rdf:type hpc:FileSystem ;
    rdfs:label "Jean Zay – Lustre parallel file system"@en ,
               "Jean Zay – système de fichiers parallèle Lustre"@fr ;
    rdfs:comment "Shared Lustre file system. Three storage tiers: 8.5 PB SSD, 44 PB rotating disks and 56 PB magnetic tape. Total throughput is not published as a single figure; per-space figures are in the mount comments."@en ,
                 "Système de fichiers Lustre partagé. Trois niveaux : 8,5 Po SSD, 44 Po disques rotatifs, 56 Po bandes magnétiques. Pas de débit global publié ; les débits par espace sont dans les commentaires des montages."@fr ;
    hpc:usesTechnology hpc:Lustre .

inst:Mount_JZ_HOME rdf:type hpc:StorageMount ;
    rdfs:label "Jean Zay – HOME"@en , "Jean Zay – HOME"@fr ;
    rdfs:comment "Per-user home, backed up. Default quota 3 GB and 150k inodes per user."@en ,
                 "Répertoire personnel par utilisateur, sauvegardé. Quota par défaut 3 Go et 150 k inodes par utilisateur."@fr ;
    hpc:mountPath "$HOME" ;
    hpc:quota "3 GB per user; 150000 inodes" ;
    hpc:isPurged false ;
    hpc:mountedOn inst:FS_JeanZay_Lustre .

inst:Mount_JZ_WORK rdf:type hpc:StorageMount ;
    rdfs:label "Jean Zay – WORK"@en , "Jean Zay – WORK"@fr ;
    rdfs:comment "Per-project workspace on rotating disks (about 350 GB/s read, 300 GB/s write). Not purged, NOT backed up. Default quota 5 TB and 500k inodes per project."@en ,
                 "Espace de travail par projet sur disques rotatifs (environ 350 Go/s en lecture, 300 Go/s en écriture). Non purgé, NON sauvegardé. Quota par défaut 5 To et 500 k inodes par projet."@fr ;
    hpc:mountPath "$WORK" ;
    hpc:quota "5 TB per project; 500000 inodes" ;
    hpc:isPurged false ;
    hpc:mountedOn inst:FS_JeanZay_Lustre .

inst:Mount_JZ_SCRATCH rdf:type hpc:StorageMount ;
    rdfs:label "Jean Zay – SCRATCH"@en , "Jean Zay – SCRATCH"@fr ;
    rdfs:comment "SSD scratch (about 1.5 TB/s read, 1.1 TB/s write), 4.6 PB shared by all users, not backed up. Unused files (not read nor modified) are deleted after 30 days. Only very large safety quotas. $JOBSCRATCH (per-job directory) is not modeled."@en ,
                 "Scratch SSD (environ 1,5 To/s en lecture, 1,1 To/s en écriture), 4,6 Po partagés par tous les utilisateurs, non sauvegardé. Les fichiers inutilisés (ni lus ni modifiés) sont supprimés après 30 jours. Quotas de sécurité très larges. $JOBSCRATCH (répertoire par job) non modélisé."@fr ;
    hpc:mountPath "$SCRATCH" ;
    hpc:isPurged true ;
    hpc:mountedOn inst:FS_JeanZay_Lustre ;
    hpc:hasStorageCapacity [
        rdf:type hpc:StorageCapacity ;
        hpc:hasValue "4.6"^^xsd:decimal ;
        hpc:hasUnit "PB"
    ] .

inst:Mount_JZ_STORE rdf:type hpc:StorageMount ;
    rdfs:label "Jean Zay – STORE"@en , "Jean Zay – STORE"@fr ;
    rdfs:comment "Long-term archive (disk cache + magnetic tape), not backed up, not purged. Default quota 50 TB and 100k inodes per project. Since 22 July 2024 only reachable from frontends and prepost/archive/compil/visu partitions, NOT from compute nodes."@en ,
                 "Archivage à long terme (cache disque + bandes), non sauvegardé, non purgé. Quota par défaut 50 To et 100 k inodes par projet. Depuis le 22 juillet 2024 accessible uniquement depuis les frontales et les partitions prepost/archive/compil/visu, PAS depuis les nœuds de calcul."@fr ;
    hpc:mountPath "$STORE" ;
    hpc:quota "50 TB per project; 100000 inodes" ;
    hpc:isPurged false ;
    hpc:mountedOn inst:FS_JeanZay_Lustre .


