inst:IC_OmniPath_100G rdf:type hpc:IntelOmniPath ;
    rdfs:label "Intel Omni-Path – 100 Gb/s"@en ,
               "Intel Omni-Path – 100 Gb/s"@fr ;
    rdfs:comment "Intel Omni-Path Architecture (OPA) 100 Gb/s interconnect used on Jean Zay's cpu_p1, gpu_p13, gpu_p2 and gpu_p5 nodes."@en ,
                 "Interconnexion Intel Omni-Path Architecture (OPA) 100 Gb/s utilisée sur les nœuds cpu_p1, gpu_p13, gpu_p2 et gpu_p5 de Jean Zay."@fr ;
    hpc:hasBandwidth inst:BW_100Gbps .

inst:IC_InfiniBand_NDR_400G rdf:type hpc:InfiniBandNDR ;
    rdfs:label "InfiniBand NDR – 400 Gb/s"@en ,
               "InfiniBand NDR – 400 Gb/s"@fr ;
    rdfs:comment "InfiniBand NDR (Next Data Rate) 400 Gb/s per port. Used in the Jean Zay H100 partition (gpu_p6)."@en ,
                 "InfiniBand NDR (Next Data Rate) 400 Gb/s par port. Utilisé dans la partition H100 (gpu_p6) de Jean Zay."@fr ;
    hpc:hasBandwidth inst:BW_400Gbps .


###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 7 – PARTITIONS (SLURM)
# ══════════════════════════════════════════════════════════════════════════════
###############################################################################

inst:Part_JZ_cpu_p1 rdf:type hpc:Partition ;
    rdfs:label "Jean Zay – cpu_p1 scalar partition"@en ,
               "Jean Zay – partition scalaire cpu_p1"@fr ;
    rdfs:comment "Scalar CPU partition. 720 Intel Cascade Lake nodes (40 cores/node, 192 GiB). SLURM partition name cpu_p1. QoS: qos_cpu-t3 (20 h), qos_cpu-t4 (100 h), qos_cpu-dev (2 h)."@en ,
                 "Partition CPU scalaire. 720 nœuds Intel Cascade Lake (40 cœurs/nœud, 192 Gio). Nom SLURM cpu_p1. QoS : qos_cpu-t3 (20 h), qos_cpu-t4 (100 h), qos_cpu-dev (2 h)."@fr ;
    hpc:partitionName "cpu_p1" ;
    hpc:partitionType "cpu" ;
    hpc:allocatedFromQuota true ;
    hpc:nodeCount 720 ;
    hpc:totalCoresCount 28800 ;
    # 720 nodes × 192 GiB = 138,240 GiB = 135 TiB
    hpc:hasTotalScalarMemory [
        rdf:type hpc:MemoryCapacity ;
        hpc:hasValue "135"^^xsd:decimal ;
        hpc:hasUnit "TiB"
    ] ;
    hpc:maxWallTime "PT100H"^^xsd:duration ;
    hpc:defaultWallTime "00:10:00" ;
    hpc:usesNodeType inst:Node_JZ_cpu_p1 ;
    hpc:hasQoS inst:qos_jz_cpu_t3 , inst:qos_jz_cpu_t4 , inst:qos_jz_cpu_dev ;
    hpc:supportsCompiler hpc:GCC , hpc:IntelCompiler .

inst:Part_JZ_gpu_p13 rdf:type hpc:Partition ; 
    rdfs:label "Jean Zay – gpu_p13 V100 partition"@en ,
               "Jean Zay – partition gpu_p13 V100"@fr ;
    rdfs:comment "V100 partition. 396 nodes (126 with 16 GB + 270 with 32 GB, 4 GPUs/node). QoS: qos_gpu-t3 (20 h), qos_gpu-t4 (100 h), qos_gpu-dev (2 h)."@en ,
                 "Partition V100. 396 nœuds (126 en 16 Go + 270 en 32 Go, 4 GPU/nœud). QoS : qos_gpu-t3 (20 h), qos_gpu-t4 (100 h), qos_gpu-dev (2 h)."@fr ;
    hpc:partitionName "gpu_p13" ;
    hpc:partitionType "gpu" ;
    hpc:allocatedFromQuota true ;
    hpc:nodeCount 396 ;
    hpc:totalCoresCount 15840 ;
    hpc:acceleratorCount 1584 ;
    hpc:maxWallTime "PT100H"^^xsd:duration ;
    hpc:defaultWallTime "00:10:00" ;
    hpc:usesNodeType inst:Node_JZ_gpu_p13_v100_16g , inst:Node_JZ_gpu_p13_v100_32g ;
    hpc:hasQoS inst:qos_jz_gpu_t3 , inst:qos_jz_gpu_t4 , inst:qos_jz_gpu_dev ;
    hpc:supportsCompiler hpc:GCC , hpc:IntelCompiler , hpc:NVCC .

inst:Part_JZ_gpu_p2 rdf:type hpc:Partition ;
    rdfs:label "Jean Zay – gpu_p2 V100 partition"@en ,
               "Jean Zay – partition gpu_p2 V100"@fr ;
    rdfs:comment "V100 partition with 8 GPUs per node: 20 gpu_p2s (384 GiB) + 11 gpu_p2l (768 GiB). QoS: qos_gpu-t3/t4/dev."@en ,
                 "Partition V100 avec 8 GPU par nœud : 20 gpu_p2s (384 Gio) + 11 gpu_p2l (768 Gio). QoS : qos_gpu-t3/t4/dev."@fr ;
    hpc:partitionName "gpu_p2" ;
    hpc:partitionType "gpu" ;
    hpc:allocatedFromQuota true ;
    hpc:nodeCount 31 ;
    hpc:totalCoresCount 744 ;
    hpc:acceleratorCount 248 ;
    hpc:maxWallTime "PT100H"^^xsd:duration ;
    hpc:defaultWallTime "00:10:00" ;
    hpc:usesNodeType inst:Node_JZ_gpu_p2s , inst:Node_JZ_gpu_p2l ;
    hpc:hasQoS inst:qos_jz_gpu_t3 , inst:qos_jz_gpu_t4 , inst:qos_jz_gpu_dev ;
    hpc:supportsCompiler hpc:GCC , hpc:IntelCompiler , hpc:NVCC .

inst:Part_JZ_gpu_p5 rdf:type hpc:Partition ;
    rdfs:label "Jean Zay – gpu_p5 A100 partition"@en ,
               "Jean Zay – partition gpu_p5 A100"@fr ;
    rdfs:comment "A100 partition (June 2022 extension). 52 nodes, 8×NVIDIA A100 80 GB per node. Select with '-C a100'. Max 20 h (no long QoS). QoS: qos_gpu_a100-t3 (20 h), qos_gpu_a100-dev (2 h)."@en ,
                 "Partition A100 (extension juin 2022). 52 nœuds, 8×NVIDIA A100 80 Go par nœud. Sélection avec '-C a100'. 20 h max (pas de QoS longue). QoS : qos_gpu_a100-t3 (20 h), qos_gpu_a100-dev (2 h)."@fr ;
    hpc:partitionName "gpu_p5" ;
    hpc:partitionType "gpu" ;
    hpc:allocatedFromQuota true ;
    hpc:nodeCount 52 ;
    hpc:totalCoresCount 3328 ;
    hpc:acceleratorCount 416 ;
    hpc:maxWallTime "PT20H"^^xsd:duration ;
    hpc:defaultWallTime "00:10:00" ;
    hpc:usesNodeType inst:Node_JZ_gpu_p5_a100 ;
    hpc:hasQoS inst:qos_jz_gpu_a100_t3 , inst:qos_jz_gpu_a100_dev ;
    hpc:supportsCompiler hpc:GCC , hpc:IntelCompiler , hpc:NVCC .

inst:Part_JZ_gpu_p6 rdf:type hpc:Partition ;
    rdfs:label "Jean Zay – gpu_p6 H100 partition"@en ,
               "Jean Zay – partition gpu_p6 H100"@fr ;
    rdfs:comment "H100 partition (July 2024 extension, Bull BullSequana XH3000). 364 nodes × 4 H100 80 GB = 1456 H100. Select with '-C h100'. QoS: qos_gpu_h100-t3 (20 h), -t4 (100 h), -dev (2 h)."@en ,
                 "Partition H100 (extension juillet 2024, Bull BullSequana XH3000). 364 nœuds × 4 H100 80 Go = 1456 H100. Sélection avec '-C h100'. QoS : qos_gpu_h100-t3 (20 h), -t4 (100 h), -dev (2 h)."@fr ;
    hpc:partitionName "gpu_p6" ;
    hpc:partitionType "gpu" ;
    hpc:allocatedFromQuota true ;
    hpc:nodeCount 364 ;
    hpc:totalCoresCount 34944 ;                            # 364×96
    hpc:acceleratorCount 1456 ;                            # 364×4
    hpc:maxWallTime "PT100H"^^xsd:duration ;
    hpc:defaultWallTime "00:10:00" ;
    hpc:usesNodeType inst:Node_JZ_gpu_p6_h100 ;
    hpc:hasQoS inst:qos_jz_gpu_h100_t3 , inst:qos_jz_gpu_h100_t4 , inst:qos_jz_gpu_h100_dev ;
    hpc:supportsCompiler hpc:GCC , hpc:IntelCompiler , hpc:NVCC .

inst:Part_JZ_prepost rdf:type hpc:Partition ; 
    rdfs:label "Jean Zay – prepost partition"@en ,
               "Jean Zay – partition pré/post-traitement"@fr ;
    rdfs:comment "Pre/post-processing partition, 4 large-memory nodes with one V100 each. Not deducted from the compute allocation. Default 2 h, max 20 h. The archive partition uses the same nodes."@en ,
                 "Partition de pré/post-traitement, 4 nœuds à large mémoire avec un V100 chacun. Non décomptée de l'allocation. 2 h par défaut, 20 h max. La partition archive utilise les mêmes nœuds."@fr ;
    hpc:partitionName "prepost" ;
    hpc:partitionType "prepost" ;
    hpc:allocatedFromQuota false ;
    hpc:nodeCount 4 ;
    hpc:totalCoresCount 192 ;
    hpc:maxWallTime "PT20H"^^xsd:duration ;
    hpc:defaultWallTime "02:00:00" ;
    hpc:usesNodeType inst:Node_JZ_prepost .

inst:Part_JZ_visu rdf:type hpc:Partition ;
    rdfs:label "Jean Zay – visu partition"@en ,
               "Jean Zay – partition visualisation"@fr ;
    rdfs:comment "Visualization partition, 5 nodes, not deducted from the compute allocation. Default 10 min, max 4 h."@en ,
                 "Partition de visualisation, 5 nœuds, non décomptée de l'allocation. 10 min par défaut, 4 h max."@fr ;
    hpc:partitionName "visu" ;
    hpc:partitionType "visualization" ;
    hpc:allocatedFromQuota false ;
    hpc:nodeCount 5 ;
    hpc:totalCoresCount 200 ;
    hpc:maxWallTime "PT4H"^^xsd:duration ;
    hpc:defaultWallTime "00:10:00" ;
    hpc:usesNodeType inst:Node_JZ_visu .

inst:Part_JZ_frontend rdf:type hpc:Partition ; 
    rdfs:label "Jean Zay – frontend partition"@en ,
               "Jean Zay – partition frontale"@fr ;
    rdfs:comment "Frontend/login nodes (SSH). NOT deducted from the compute allocation. Note: IDRIS also has compil, compil_h100 and archive service partitions, not modeled here."@en ,
                 "Nœuds frontaux de connexion (SSH). NON décomptés de l'allocation. Note : l'IDRIS dispose aussi des partitions de service compil, compil_h100 et archive, non modélisées ici."@fr ;
    hpc:partitionName "frontend" ;
    hpc:partitionType "frontend" ;
    hpc:allocatedFromQuota false ;
    hpc:nodeCount 5 ;
    hpc:totalCoresCount 200 ;  # 5 nodes x 40 coeurs per node
    hpc:usesNodeType inst:Node_JZ_frontend .

###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 8 – QUALITY OF SERVICE (QoS)
# ══════════════════════════════════════════════════════════════════════════════
# EN – Concrete Jean Zay QoS from jean_zay.json. Quotas and time limits are
#      carried in rdfs:comment because the current ontology has no dedicated
#      QoS quota datatype property. The partition-level hpc:maxWallTime
#      already records the maximum.
# FR – QoS concrètes de Jean Zay (jean_zay.json). Les quotas et limites de
#      temps sont portés par rdfs:comment car l'ontologie n'a pas encore de
#      propriété de quota dédiée à la QoS.
###############################################################################

inst:qos_jz_cpu_t3 rdf:type hpc:QoS  ;
    rdfs:label "Jean Zay CPU Default QoS (t3)"@en ;
    rdfs:comment "Default QoS for CPU jobs on Jean Zay with standard limits."@en ;
    hpc:isDefaultQoS "true"^^xsd:boolean ;
    hpc:maxWallTime "PT20H"^^xsd:duration ;          # 20 horas máximo
    hpc:maxNodesPerJob 256 ;                        # 256 nodos (10240 cœurs physiques)
    hpc:maxCoresPerJob 10240 ;
    hpc:maxCoresPerUser 20480 ;                     # 512 nodos (20480 cœurs)
    hpc:maxCoresPerProject 20480 .                  # 512 nodos (20480 cœurs)

# long executions
inst:qos_jz_cpu_t4 rdf:type hpc:QoS  ;
    rdfs:label "Jean Zay CPU Long Jobs QoS (t4)"@en ;
    rdfs:comment "QoS for longer executions up to 100h with restricted scale."@en ;
    hpc:isDefaultQoS "false"^^xsd:boolean ;
    hpc:maxWallTime "PT100H"^^xsd:duration ;         # 100 horas máximo
    hpc:maxNodesPerJob 4 ;                          # 4 nodos (160 cœurs)
    hpc:maxCoresPerJob 160 ;
    hpc:maxCoresPerUser 640 ;                       # 16 nodos (640 cœurs)
    hpc:maxCoresPerProject 640 .                    # 16 nodos (640 cœurs)

# development and tests -
inst:qos_jz_cpu_dev rdf:type hpc:QoS  ;
    rdfs:label "Jean Zay CPU Development QoS (dev)"@en ;
    rdfs:comment "QoS reserved for brief code developments and test executions."@en ;
    hpc:isDefaultQoS "false"^^xsd:boolean ;
    hpc:maxWallTime "PT2H"^^xsd:duration ;          # 2 horas máximo
    hpc:maxNodesPerJob 128 ;                        # 128 nodos (5120 cœurs)
    hpc:maxCoresPerJob 5120 ;
    hpc:maxCoresPerUser 5120 ;                      # 128 nodos por usuario
    hpc:maxCoresPerProject 5120 ;                   # 128 nodos por proyecto
    hpc:maxJobsPerUser 10 .                         # Máximo 10 trabajos simultáneos

# --- V100 GPU QoS instances ---
# Default QoS for V100 GPU jobs.
inst:qos_jz_gpu_t3 rdf:type hpc:QoS ;
    rdfs:label "Jean Zay V100 GPU Default QoS (t3)"@en,
        "QoS GPU V100 par défaut de Jean Zay (t3)"@fr ;
    rdfs:comment "Default QoS for V100 GPU jobs, with a maximum elapsed wall time of 20 hours and limits of 640 GPUs per job, per user, and per project."@en,
        "QoS par défaut pour les travaux GPU V100, avec une durée maximale écoulée de 20 heures et des limites de 640 GPU par travail, par utilisateur et par projet."@fr ;
    hpc:isDefaultQoS true ;
    hpc:maxWallTime "PT20H"^^xsd:duration ;
    hpc:maxGpusPerJob 640 ;
    hpc:maxGpusPerUser 640 ;
    hpc:maxGpusPerProject 640 .

# Extended wall-time QoS for V100 GPU jobs.
inst:qos_jz_gpu_t4 rdf:type hpc:QoS ;
    rdfs:label "Jean Zay V100 GPU Extended QoS (t4)"@en,
        "QoS GPU V100 longue durée de Jean Zay (t4)"@fr ;
    rdfs:comment "QoS for longer V100 GPU jobs, which must be explicitly requested. Maximum elapsed wall time is 100 hours, with limits of 16 GPUs per job, 96 GPUs per user, 96 GPUs per project, and 256 GPUs across all jobs using this QoS (not modeled in the instance)."@en,
        "QoS pour les travaux GPU V100 de longue durée, qui doit être demandée explicitement. La durée maximale écoulée est de 100 heures, avec des limites de 16 GPU par travail, 96 GPU par utilisateur, 96 GPU par projet et 256 GPU pour l'ensemble des travaux utilisant cette QoS."@fr ;
    hpc:isDefaultQoS false ;
    hpc:maxWallTime "PT100H"^^xsd:duration ;
    hpc:maxGpusPerJob 16 ;
    hpc:maxGpusPerUser 96 ;
    hpc:maxGpusPerProject 96 .

# Development and testing QoS for V100 GPU jobs.
inst:qos_jz_gpu_dev rdf:type hpc:QoS ;
    rdfs:label "Jean Zay V100 GPU Development QoS"@en,
        "QoS GPU V100 de développement de Jean Zay"@fr ;
    rdfs:comment "QoS reserved for short V100 GPU development and testing jobs. Maximum elapsed wall time is 2 hours. Limits are 32 GPUs per job, per user, and per project, 10 simultaneous pending or running jobs per user, and 512 GPUs across all jobs using this QoS (maxGpusPerQoS, not modeled in the instance)."@en,
        "QoS réservée aux travaux courts de développement et de test sur GPU V100. La durée maximale écoulée est de 2 heures. Les limites sont de 32 GPU par travail, par utilisateur et par projet, de 10 travaux simultanés en attente ou en cours d'exécution par utilisateur, et de 512 GPU pour l'ensemble des travaux utilisant cette QoS."@fr ;
    hpc:isDefaultQoS false ;
    hpc:maxWallTime "PT2H"^^xsd:duration ;
    hpc:maxGpusPerJob 32 ;
    hpc:maxGpusPerUser 32 ;
    hpc:maxGpusPerProject 32 ;
    hpc:maxJobsPerUser 10 .

# --- A100 GPU QoS instances ---
# Default QoS for A100 GPU jobs.
inst:qos_jz_gpu_a100_t3 rdf:type hpc:QoS ;
    rdfs:label "Jean Zay A100 GPU Default QoS (t3)"@en,
        "QoS GPU A100 par défaut de Jean Zay (t3)"@fr ;
    rdfs:comment "Default QoS for A100 GPU jobs, with a maximum elapsed wall time of 20 hours and limits of 128 GPUs per job, 256 GPUs per user, and 256 GPUs per project. No aggregate QoS GPU limit is specified in the supplied documentation."@en,
        "QoS par défaut pour les travaux GPU A100, avec une durée maximale écoulée de 20 heures et des limites de 128 GPU par travail, 256 GPU par utilisateur et 256 GPU par projet. Aucun plafond global de GPU par QoS n'est indiqué dans la documentation fournie."@fr ;
    hpc:isDefaultQoS true ;
    hpc:maxWallTime "PT20H"^^xsd:duration ;
    hpc:maxGpusPerJob 128 ;
    hpc:maxGpusPerUser 256 ;
    hpc:maxGpusPerProject 256 .

# Development and testing QoS for A100 GPU jobs.
inst:qos_jz_gpu_a100_dev rdf:type hpc:QoS ;
    rdfs:label "Jean Zay A100 GPU Development QoS"@en,
        "QoS GPU A100 de développement de Jean Zay"@fr ;
    rdfs:comment "QoS reserved for short A100 GPU development and testing jobs. Maximum elapsed wall time is 2 hours. Limits are 32 GPUs per job, per user, and per project, 10 simultaneous pending or running jobs per user, and 128 GPUs across all jobs using this QoS (maxGpusPerQoS, not modeled in the instance)."@en,
        "QoS réservée aux travaux courts de développement et de test sur GPU A100. La durée maximale écoulée est de 2 heures. Les limites sont de 32 GPU par travail, par utilisateur et par projet, de 10 travaux simultanés en attente ou en cours d'exécution par utilisateur, et de 128 GPU pour l'ensemble des travaux utilisant cette QoS."@fr ;
    hpc:isDefaultQoS false ;
    hpc:maxWallTime "PT2H"^^xsd:duration ;
    hpc:maxGpusPerJob 32 ;
    hpc:maxGpusPerUser 32 ;
    hpc:maxGpusPerProject 32 ;
    hpc:maxJobsPerUser 10 .

# --- H100 GPU QoS instances ---
# Default QoS for H100 GPU jobs.
inst:qos_jz_gpu_h100_t3 rdf:type hpc:QoS ;
    rdfs:label "Jean Zay H100 GPU Default QoS (t3)"@en,
        "QoS GPU H100 par défaut de Jean Zay (t3)"@fr ;
    rdfs:comment "Default QoS for H100 GPU jobs, with a maximum elapsed wall time of 20 hours and limits of 512 GPUs per job, per user, and per project. No aggregate QoS GPU limit is specified in the supplied documentation."@en,
        "QoS par défaut pour les travaux GPU H100, avec une durée maximale écoulée de 20 heures et des limites de 512 GPU par travail, par utilisateur et par projet. Aucun plafond global de GPU par QoS n'est indiqué dans la documentation fournie."@fr ;
    hpc:isDefaultQoS true ;
    hpc:maxWallTime "PT20H"^^xsd:duration ;
    hpc:maxGpusPerJob 512 ;
    hpc:maxGpusPerUser 512 ;
    hpc:maxGpusPerProject 512 .

# Extended wall-time QoS for H100 GPU jobs.
inst:qos_jz_gpu_h100_t4 rdf:type hpc:QoS ;
    rdfs:label "Jean Zay H100 GPU Extended QoS (t4)"@en,
        "QoS GPU H100 longue durée de Jean Zay (t4)"@fr ;
    rdfs:comment "QoS for longer H100 GPU jobs, which must be explicitly requested. Maximum elapsed wall time is 100 hours, with limits of 16 GPUs per job, 64 GPUs per user, 64 GPUs per project, and 192 GPUs across all jobs using this QoS (maxGpusPerQoS, not modeled in the instance)."@en,
        "QoS pour les travaux GPU H100 de longue durée, qui doit être demandée explicitement. La durée maximale écoulée est de 100 heures, avec des limites de 16 GPU par travail, 64 GPU par utilisateur, 64 GPU par projet et 192 GPU pour l'ensemble des travaux utilisant cette QoS."@fr ;
    hpc:isDefaultQoS false ;
    hpc:maxWallTime "PT100H"^^xsd:duration ;
    hpc:maxGpusPerJob 16 ;
    hpc:maxGpusPerUser 64 ;
    hpc:maxGpusPerProject 64 .

# Development and testing QoS for H100 GPU jobs.
inst:qos_jz_gpu_h100_dev rdf:type hpc:QoS ;
    rdfs:label "Jean Zay H100 GPU Development QoS"@en,
        "QoS GPU H100 de développement de Jean Zay"@fr ;
    rdfs:comment "QoS reserved for short H100 GPU development and testing jobs. Maximum elapsed wall time is 2 hours. Limits are 32 GPUs per job, per user, and per project, 10 simultaneous pending or running jobs per user, and 384 GPUs across all jobs using this QoS (maxGpusPerQoS, not modeled in the instance)."@en,
        "QoS réservée aux travaux courts de développement et de test sur GPU H100. La durée maximale écoulée est de 2 heures. Les limites sont de 32 GPU par travail, par utilisateur et par projet, de 10 travaux simultanés en attente ou en cours d'exécution par utilisateur, et de 384 GPU pour l'ensemble des travaux utilisant cette QoS."@fr ;
    hpc:isDefaultQoS false ;
    hpc:maxWallTime "PT2H"^^xsd:duration ;
    hpc:maxGpusPerJob 32 ;
