# ──── prepost / visu / frontend (representative) ─────────────────────────────
inst:Node_JZ_prepost rdf:type hpc:PrePostNode ;
    rdfs:label "Jean Zay – prepost node type"@en ,
               "Jean Zay – type nœud pré/post-traitement"@fr ;
    rdfs:comment "4 large-memory pre/post-processing nodes: 4×Intel Skylake 6132 (12 cores @ 3.2 GHz as documented, 48 cores/node), 3 TiB memory, 1×NVIDIA Tesla V100, 1.5 TB internal NVMe (not modeled). Also used by the archive partition. Not deducted from the compute allocation."@en ,
                 "4 nœuds de pré/post-traitement à large mémoire : 4×Intel Skylake 6132 (12 cœurs à 3,2 GHz selon la doc, 48 cœurs/nœud), 3 To de mémoire, 1×NVIDIA Tesla V100, disque NVMe interne de 1,5 To (non modélisé). Utilisés aussi par la partition archive. Non décomptés de l'allocation."@fr ;
