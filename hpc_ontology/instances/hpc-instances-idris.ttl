###############################################################################
# HPC Resource Ontology – IDRIS INSTANCES 
# Center: IDRIS (Orsay, CNRS)  –  System: Jean Zay (HPE SGI 8600)
#
# Status  : IDRIS-only instances.
# Version : 1.0
# Date    : 2026-10-28
#
# Scope
# -----
# This file contains ONLY the IDRIS / Jean Zay individuals. 
#
# It imports the shared ontology (hpc.ttl -> hpc-core.ttl) and the centers
# file (hpc-centers.ttl) which defines Center_IDRIS, Org_IDRIS, Org_CNRS,
# Org_GENCI, ...
#
# Main sources
# ------------
#   http://www.idris.fr/docs/jean-zay/jean-zay/jean-zay-hardware/
#   http://www.idris.fr/docs/jean-zay/environnement/espaces-disques/
#
# Confidence markers
# ------------------
#   [TBC] value to be confirmed. Extrapolated / representative value.
#
# Authors : Exa-AToW team - CHC
###############################################################################

@prefix hpc:      <https://w3id.org/Exa-AToW/hpc#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:       <http://purl.org/dc/elements/1.1/> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix schema:   <https://schema.org/> .
@prefix inst:     <https://w3id.org/Exa-AToW/hpc/instances/> .

<https://w3id.org/Exa-AToW/hpc/instances/hpc-instances-idris.ttl>
    rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/Exa-AToW/hpc/instances/hpc-centers.ttl> ,
                <https://w3id.org/Exa-AToW/hpc/hpc.ttl> ;
    rdfs:label "HPC Instances – IDRIS (Jean Zay)"@en ,
               "Instances HPC – IDRIS (Jean Zay)"@fr ;
    dc:description "IDRS-only instance set: the Jean Zay supercomputer at IDRIS, its processors, cards, compute node types, partitions, QoS, modules, storage, operating system and quantitative values."@en ;
    owl:versionInfo "1.0" .


###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 1 – LINKS CENTER → INFRASTRUCTURE
# ══════════════════════════════════════════════════════════════════════════════
# EN – Center_IDRIS is defined in hpc-centers.ttl (imported). Here only its
#      outgoing links to the system and the user storage mounts.
# FR – Center_IDRIS est défini dans hpc-centers.ttl (importé). Ici uniquement
#      ses liens vers le système et les points de montage utilisateur.
###############################################################################

inst:Center_IDRIS hpc:hosts inst:SC_JeanZay ;
    hpc:hasStorageMount inst:Mount_JZ_HOME ,
                             inst:Mount_JZ_WORK ,
                             inst:Mount_JZ_SCRATCH ,
                             inst:Mount_JZ_STORE .


###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 2 – SUPERCOMPUTER
# ══════════════════════════════════════════════════════════════════════════════
# EN – Jean Zay is an HPE SGI 8600 at IDRIS, Orsay, operated for CNRS within
#      GENCI. CPU partition (cpu_p1), V100 partitions (gpu_p13, gpu_p2),
#      A100 partition (gpu_p5) and H100 extension (gpu_p6), plus prepost, visu
#      and frontend. ~125.9 PFlop/s peak total since 2024. SLURM.
# FR – Jean Zay est un HPE SGI 8600 à l'IDRIS, Orsay, exploité pour le CNRS
#      dans le cadre de GENCI. Partition CPU (cpu_p1), partitions V100
#      (gpu_p13, gpu_p2), partition A100 (gpu_p5) et extension H100 (gpu_p6),
#      plus prepost, visu et frontaux. ~125,9 PFlop/s crête depuis 2024. SLURM.
###############################################################################

inst:SC_JeanZay rdf:type hpc:Supercomputer ;
    rdfs:label "Jean Zay"@en , "Jean Zay"@fr ;
    rdfs:comment "Supercomputer at IDRIS (Orsay): HPE SGI 8600 part (cpu_p1, gpu_p13, gpu_p2, gpu_p5; Intel Omni-Path) plus Bull BullSequana XH3000 part (gpu_p6, H100; InfiniBand). CPU partition (Intel Xeon Gold 6248), V100 partitions (gpu_p13, gpu_p2), A100 partition (gpu_p5) and H100 extension (gpu_p6). ~125.9 PFlop/s peak total since 2024. Scheduler: SLURM."@en ,
                 "Supercalculateur de l'IDRIS (Orsay) : partie HPE SGI 8600 (cpu_p1, gpu_p13, gpu_p2, gpu_p5 ; Intel Omni-Path) et partie Bull BullSequana XH3000 (gpu_p6, H100 ; InfiniBand). Partition CPU (Intel Xeon Gold 6248), partitions V100 (gpu_p13, gpu_p2), partition A100 (gpu_p5) et extension H100 (gpu_p6). ~125,9 PFlop/s crête totale depuis 2024. Ordonnanceur : SLURM."@fr ;
    hpc:shortName "jean-zay" ;
    hpc:identifier "jean-zay.idris.fr" ;
    hpc:hostedAt inst:Center_IDRIS ;
    hpc:commissioningDate "2019-06-01"^^xsd:date ;   # first phase in production mid-2019; H100 extension 2023/2024
    hpc:documentationURL "http://www.idris.fr/docs/jean-zay/jean-zay/jean-zay-hardware/"^^xsd:anyURI ;
    dcterms:source <http://www.idris.fr/docs/jean-zay/jean-zay/jean-zay-hardware> ,
                   <http://www.idris.fr/docs/jean-zay/slurm/slurm_partitions_gpu> ,
                   <http://www.idris.fr/docs/jean-zay/slurm/slurm_partitions_cpu> ,
                   <http://www.idris.fr/docs/jean-zay/environnement/espaces-disques> ;
    hpc:usesResourceManager hpc:SLURM ;
    hpc:runsOS inst:OS_RHEL96 ;
    hpc:usesFileSystem inst:FS_JeanZay_Lustre ;
    hpc:fundedBy inst:Org_GENCI ;
    hpc:supportsCompiler hpc:GCC , hpc:IntelCompiler , hpc:NVCC ;
    hpc:hasPartition inst:Part_JZ_cpu_p1 ,
                           inst:Part_JZ_gpu_p13 ,
                           inst:Part_JZ_gpu_p2 ,
                           inst:Part_JZ_gpu_p5 ,
                           inst:Part_JZ_gpu_p6 ,
                           inst:Part_JZ_prepost ,
                           inst:Part_JZ_visu ,
                           inst:Part_JZ_frontend ;
    hpc:hasPeakPerformance inst:Perf_JZ_125PFlops ;
    hpc:computerBrand "HPE / Eviden (Bull)" ;
    hpc:model "HPE SGI 8600 + Bull BullSequana XH3000" ;
    hpc:frontendNodeCount 5 ;                        
    # Compute partitions: 720 cpu_p1 + 396 gpu_p13 + 31 gpu_p2 + 52 gpu_p5 + 364 gpu_p6
    hpc:nodeCount 1563 ;                             #  sum of partitions
    # 720×40 + 396×40 + 31×24 + 52×64 + 364×96 = 83656
    hpc:totalCoresCount 83656 .                      #  sum of partitions


###############################################################################
# ══════════════════════════════════════════════════════════════════════════════
# SECTION 3 – PROCESSORS
# ══════════════════════════════════════════════════════════════════════════════
###############################################################################

# ────────── CPUs ──────────────────────────────────────────────────────────────

inst:CPU_Intel_XeonGold_6248 rdf:type hpc:CPU ; 
    rdfs:label "Intel Xeon Gold 6248 (Cascade Lake)"@en ;
    rdfs:comment "20-core Intel Cascade Lake CPU at 2.5 GHz. CPU of Jean Zay cpu_p1, gpu_p13, visu and frontend nodes (2 per node)."@en ,
                 "CPU Intel Cascade Lake 20 cœurs à 2,5 GHz. CPU des nœuds cpu_p1, gpu_p13, visu et frontaux de Jean Zay (2 par nœud)."@fr ;
    hpc:vendor "Intel" ;
    hpc:model "Intel Xeon Gold 6248" ;
    hpc:architecture "Cascade Lake" ;
    hpc:coresCountPerSocket 20 ;
    hpc:threadCount 40 ;
    hpc:hasFrequency inst:Freq_2_5GHz .

