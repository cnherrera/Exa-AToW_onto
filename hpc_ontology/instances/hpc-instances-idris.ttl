               "Red Hat Enterprise Linux 9.6"@fr ;
    rdfs:comment "RHEL 9.6 deployed on Jean Zay since 17/02/2026 (RHEL 9.4 before). Slurm 23.11.3 since 01/10/2024."@en ,
                 "RHEL 9.6 déployé sur Jean Zay depuis le 17/02/2026 (RHEL 9.4 auparavant). Slurm 23.11.3 depuis le 01/10/2024."@fr ;
    hpc:softwareName "Red Hat Enterprise Linux" ;
    hpc:osVersion "9.6" ;
    hpc:vendor "Red Hat" .


