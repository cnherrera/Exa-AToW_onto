    rdfs:label "Intel Xeon Skylake 6132 (prepost)"@en ;
    rdfs:comment "Intel Skylake CPU of the prepost nodes (4 per node), documented by IDRIS as 12 cores at 3.2 GHz."@en ,
                 "CPU Intel Skylake des nœuds prepost (4 par nœud), documenté par l'IDRIS à 12 cœurs à 3,2 GHz."@fr ;
    hpc:vendor "Intel" ;
