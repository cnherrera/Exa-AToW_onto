    rdfs:comment "CPU RAM for Jean Zay cpu_p1, gpu_p13, visu and frontend nodes. 192 GiB per node."@en ,
                 "RAM CPU pour les nœuds cpu_p1, gpu_p13, visu et frontaux de Jean Zay. 192 Gio par nœud."@fr ;
    hpc:memoryModel "DDR4-2933" ;
    hpc:hasMemoryCapacity [
        rdf:type hpc:MemoryCapacity ;
        hpc:hasValue "192"^^xsd:decimal ;
        hpc:hasUnit "GiB"
    ] .

