# ──── Clock frequencies ──────────────────────────────────────────────────────
inst:Freq_2_1GHz rdf:type hpc:Frequency ; hpc:hasValue "2.1"^^xsd:decimal ; hpc:hasUnit "GHz" .
inst:Freq_2_5GHz rdf:type hpc:Frequency ; hpc:hasValue "2.5"^^xsd:decimal ; hpc:hasUnit "GHz" .
inst:Freq_2_7GHz rdf:type hpc:Frequency ; hpc:hasValue "2.7"^^xsd:decimal ; hpc:hasUnit "GHz" .
inst:Freq_2_8GHz rdf:type hpc:Frequency ; hpc:hasValue "2.8"^^xsd:decimal ; hpc:hasUnit "GHz" .
inst:Freq_3_2GHz rdf:type hpc:Frequency ; hpc:hasValue "3.2"^^xsd:decimal ; hpc:hasUnit "GHz" .

# ──── Interconnect bandwidths ─────────────────────────────────────────────────
inst:BW_100Gbps rdf:type hpc:Bandwidth ; hpc:hasValue "100"^^xsd:decimal ; hpc:hasUnit "Gb/s" .
inst:BW_400Gbps rdf:type hpc:Bandwidth ; hpc:hasValue "400"^^xsd:decimal ; hpc:hasUnit "Gb/s" .

